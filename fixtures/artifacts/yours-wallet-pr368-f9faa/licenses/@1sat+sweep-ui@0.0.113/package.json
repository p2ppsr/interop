    "bsv",
    "ordinals",
    "sweep",
    "migration",
    "react"
  ],
  "license": "MIT",
  "dependencies": {
    "@1sat/actions": "0.0.235",
    "@1sat/client": "0.0.64",
    "@1sat/connect": "0.0.106",
    "@1sat/types": "0.0.53",
    "@1sat/utils": "0.0.43",
    "bitcoin-backup": "^0.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.6.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@bsv/sdk": "^2.6.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "~5.7.0"
  }
