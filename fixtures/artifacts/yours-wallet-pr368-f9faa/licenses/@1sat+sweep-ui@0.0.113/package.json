{
  "name": "@1sat/sweep-ui",
  "version": "0.0.113",
  "description": "Sweep UI components for migrating legacy BSV assets",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run build.ts && tsc --emitDeclarationOnly",
    "dev": "tsc --watch"
  },
  "keywords": [
