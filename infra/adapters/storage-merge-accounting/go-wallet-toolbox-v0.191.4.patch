+// FindTransactionByUserIDAndTxIDForUpdate is used only inside internalization's
+// existing unit of work. PostgreSQL/MySQL lock the row before output decisions;
+// SQLite serializes conflicting writes and rolls back a stale unit of work.
+func (txs *Transactions) FindTransactionByUserIDAndTxIDForUpdate(ctx context.Context, userID int, txID string) (*pkgentity.Transaction, error) {
+	var row models.Transaction
+	err := txs.db.WithContext(ctx).Clauses(clause.Locking{Strength: "UPDATE"}).Scopes(scopes.UserID(userID)).Where("tx_id = ?", txID).First(&row).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to lock transaction for merge: %w", err)
+	}
+	return txs.mapModelToTransactionEntity(&row), nil
+}
+
+// SetTransactionSatoshis cannot change another owner's row or overwrite a
+// concurrent balance. The caller's unit of work includes all output mutations.
+func (txs *Transactions) SetTransactionSatoshis(ctx context.Context, userID int, transactionID uint, previous, next int64) error {
+	if userID <= 0 || transactionID == 0 {
+		return fmt.Errorf("invalid transaction owner")
+	}
+	if _, err := satoshi.From(previous); err != nil {
+		return err
+	}
+	if _, err := satoshi.From(next); err != nil {
+		return err
+	}
+	query := txs.db.WithContext(ctx).Model(&models.Transaction{}).Where("id = ? AND user_id = ? AND satoshis = ?", transactionID, userID, previous)
+	if previous == next {
+		var count int64
+		if err := query.Count(&count).Error; err != nil {
+			return err
+		}
+		if count != 1 {
+			return fmt.Errorf("merged transaction accounting changed or owner differs")
+		}
+		return nil
+	}
+	result := query.Update("satoshis", next)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update transaction satoshis: %w", result.Error)
+	}
+	if result.RowsAffected != 1 {
+		return fmt.Errorf("merged transaction accounting changed or owner differs")
+	}
+	return nil
+}
