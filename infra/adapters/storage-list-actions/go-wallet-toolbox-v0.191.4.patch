+package wdk
+
+import (
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestTPNILListActionsOptionalArraysPreserveRequestedEmpty(t *testing.T) {
+	for _, included := range []bool{false, true} {
+		action := WalletAction{Satoshis: -137}
+		if included {
+			action.Labels = []string{}
+			action.Inputs = []WalletActionInput{}
+			action.Outputs = []WalletActionOutput{}
+		}
+		bytes, err := json.Marshal(action)
+		require.NoError(t, err)
+		var value map[string]json.RawMessage
+		require.NoError(t, json.Unmarshal(bytes, &value))
+		for _, key := range []string{"labels", "inputs", "outputs"} {
+			if included {
+				require.Equal(t, "[]", string(value[key]), key)
+			} else {
+				require.NotContains(t, value, key)
+			}
+		}
+		require.Equal(t, "-137", string(value["satoshis"]), "signed net balance is not a shape-normalization target")
+	}
+}
