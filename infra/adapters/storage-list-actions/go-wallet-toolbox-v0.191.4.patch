+func TestTPNILListActionsRequestedEmptyOutputsAndLabels(t *testing.T) {
+	list := &listActions{}
+	rows := []wdk.WalletAction{{Satoshis: 0}}
+	txs := []*pkgentity.Transaction{{ID: 1}}
+	require.NoError(t, list.mapInputsOutputsLabels(rows, txs, mapActionDetails{labelMap: map[uint][]string{}, outputMap: map[uint][]*pkgentity.Output{}}, &wdk.ListActionsArgs{IncludeOutputs: to.Ptr(primitives.BooleanDefaultFalse(true)), IncludeLabels: to.Ptr(primitives.BooleanDefaultFalse(true))}, false))
+	bytes, err := json.Marshal(rows[0])
+	require.NoError(t, err)
+	var wire map[string]json.RawMessage
+	require.NoError(t, json.Unmarshal(bytes, &wire))
+	require.Equal(t, "[]", string(wire["labels"]))
+	require.Equal(t, "[]", string(wire["outputs"]))
+	require.NotContains(t, wire, "inputs")
+	require.Equal(t, "0", string(wire["satoshis"]))
+}
+
+func TestTPNILListActionsGeneratedChangeDescriptionAndCallerMetadata(t *testing.T) {
+	creator := &create{random: randomizer.NewTestRandomizer()}
+	distribution := func(yield func(satoshi.Value) bool) { yield(satoshi.MustFrom(250)) }
+	outputs, err := creator.newOutputs(distribution, 1, "prefix", []wdk.ValidCreateActionOutput{{Satoshis: 1, OutputDescription: "Caller output description", LockingScript: "51"}}, nil, false, &wdk.ShapedChange{Satoshis: 100, Count: 1, Basket: "fuel"})
+	require.NoError(t, err)
+	require.Len(t, outputs, 3)
+	require.Equal(t, "Caller output description", outputs[0].Description)
+	for _, output := range outputs[1:] {
+		require.True(t, output.Change)
+		require.Equal(t, "Change output", output.Description)
+	}
+}
