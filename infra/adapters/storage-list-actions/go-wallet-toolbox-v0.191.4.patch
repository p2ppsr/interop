+type tpnilListTransactions struct {
+	TransactionsRepo
+	rows []*pkgentity.Transaction
+}
+
+func (r tpnilListTransactions) ListAndCountActions(context.Context, int, entity.ListActionsFilter) ([]*pkgentity.Transaction, int64, error) {
+	return r.rows, int64(len(r.rows)), nil
+}
+func (r tpnilListTransactions) GetLabelsForSelectedActions(context.Context, int, entity.ListActionsFilter) (map[uint][]string, error) {
+	return map[uint][]string{}, nil
+}
+
+type tpnilListOutputs struct {
+	OutputRepo
+	input, output    *pkgentity.Output
+	requestedScripts []bool
+}
+
+func (r *tpnilListOutputs) FindInputsAndOutputsForSelectedActions(_ context.Context, _ int, _ entity.ListActionsFilter, scripts bool) (map[uint][]*pkgentity.Output, map[uint][]*pkgentity.Output, error) {
+	r.requestedScripts = append(r.requestedScripts, scripts)
+	input, output := *r.input, *r.output
+	if !scripts {
+		input.LockingScript = nil
+		output.LockingScript = nil
+	}
+	return map[uint][]*pkgentity.Output{1: {&input}}, map[uint][]*pkgentity.Output{1: {&output}}, nil
+}
+
+type tpnilKnownTransactions struct {
+	KnownTxRepo
+	txid string
+	raw  []byte
+}
+
+func (r tpnilKnownTransactions) FindKnownTxRawTxs(context.Context, []string) (map[string][]byte, error) {
+	return map[string][]byte{r.txid: r.raw}, nil
+}
+
+func TestTPNILListActionsIndependentScriptFlagsAndAlwaysSequence(t *testing.T) {
+	sourceTxID := strings.Repeat("11", 32)
+	// Real wire transaction with one source input, OP_TRUE unlock and non-default sequence.
+	tx, err := transaction.NewTransactionFromHex("0100000001" + sourceTxID + "00000000015178563412010100000000000000015100000000")
+	require.NoError(t, err)
+	txid := tx.TxID().String()
+	for mask := 0; mask < 8; mask++ {
+		t.Run(fmt.Sprint(mask), func(t *testing.T) {
+			inputScript, unlockScript, outputScript := mask&1 != 0, mask&2 != 0, mask&4 != 0
+			outputs := &tpnilListOutputs{input: &pkgentity.Output{TxID: &sourceTxID, Vout: 0, Satoshis: 200, Description: "Original input metadata", LockingScript: []byte{0x52}}, output: &pkgentity.Output{Vout: 0, Satoshis: 1, Description: "Original output metadata", LockingScript: []byte{0x51}, BasketName: to.Ptr("basket")}}
+			list := newListActions(logging.NewTestLogger(t), tpnilListTransactions{rows: []*pkgentity.Transaction{{ID: 1, TxID: &txid, Satoshis: -199, Description: "Original action metadata"}}}, outputs, tpnilKnownTransactions{txid: txid, raw: tx.Bytes()}, nil)
+			args := &wdk.ListActionsArgs{IncludeInputs: to.Ptr(primitives.BooleanDefaultFalse(true)), IncludeOutputs: to.Ptr(primitives.BooleanDefaultFalse(true)), IncludeLabels: to.Ptr(primitives.BooleanDefaultFalse(true)), IncludeInputSourceLockingScripts: to.Ptr(primitives.BooleanDefaultFalse(inputScript)), IncludeInputUnlockingScripts: to.Ptr(primitives.BooleanDefaultFalse(unlockScript)), IncludeOutputLockingScripts: to.Ptr(primitives.BooleanDefaultFalse(outputScript))}
+			result, err := list.ListActions(t.Context(), wdk.AuthID{UserID: to.Ptr(7)}, args)
+			require.NoError(t, err)
+			require.Len(t, result.Actions, 1)
+			row := result.Actions[0]
+			require.Equal(t, int64(-199), row.Satoshis)
+			require.Empty(t, row.Labels)
+			require.NotNil(t, row.Labels)
+			require.Equal(t, uint32(0x12345678), row.Inputs[0].SequenceNumber)
+			require.Equal(t, "Original input metadata", row.Inputs[0].InputDescription)
+			require.Equal(t, "Original output metadata", row.Outputs[0].OutputDescription)
+			require.Equal(t, []bool{inputScript || outputScript}, outputs.requestedScripts)
+			require.Equal(t, map[bool]string{true: "52", false: ""}[inputScript], row.Inputs[0].SourceLockingScript)
+			require.Equal(t, map[bool]string{true: "51", false: ""}[unlockScript], row.Inputs[0].UnlockingScript)
+			require.Equal(t, map[bool]string{true: "51", false: ""}[outputScript], row.Outputs[0].LockingScript)
+			bytes, err := json.Marshal(row.Outputs[0])
+			require.NoError(t, err)
+			var wire map[string]json.RawMessage
+			require.NoError(t, json.Unmarshal(bytes, &wire))
+			require.Equal(t, "[]", string(wire["tags"]))
+		})
+	}
+}
