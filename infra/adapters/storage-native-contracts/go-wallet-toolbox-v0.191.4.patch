+func TestTPNILNativeRelinquishmentRPC(t *testing.T) {
+	given, cleanup := testabilities.Given(t)
+	defer cleanup()
+	provider := given.Provider().GORM()
+	tx, _ := given.Faucet(provider, testusers.Alice).TopUp(100000)
+	certificate := fixtures.DefaultInsertCertAuth(testusers.Alice.ID, primitives.PubKeyHex(testusers.Alice.PubKey(t)))
+	_, err := provider.InsertCertificateAuth(t.Context(), testusers.Alice.AuthID(), certificate)
+	require.NoError(t, err)
+	stop := given.StartedRPCServerFor(provider, allowUnauthenticated)
+	defer stop()
+	cases := []struct {
+		method string
+		args   any
+	}{
+		{"relinquishOutput", wdk.RelinquishOutputArgs{Basket: wdk.BasketNameForChange, Output: string(primitives.NewOutpointString(tx.ID().String(), 0))}},
+		{"relinquishCertificate", wdk.RelinquishCertificateArgs{Type: fixtures.TypeField, SerialNumber: fixtures.SerialNumber, Certifier: fixtures.Certifier}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.method, func(t *testing.T) {
+			denied := callJSONRPC(t, given.ServerURL(), testusers.Bob, tc.method, []any{testusers.Alice.AuthID(), tc.args})
+			require.NotNil(t, denied.Error)
+			require.Contains(t, denied.Error.Message, "identityKey does not match authentication")
+			status, body := postUnauthenticated(t, given.ServerURL(), "/", map[string]any{"jsonrpc": "2.0", "id": 1, "method": tc.method, "params": []any{testusers.Alice.AuthID(), tc.args}})
+			require.Equal(t, 200, status)
+			var unauthed jsonRPCResponse
+			require.NoError(t, json.Unmarshal(body, &unauthed))
+			require.NotNil(t, unauthed.Error)
+			result := callJSONRPC(t, given.ServerURL(), testusers.Alice, tc.method, []any{testusers.Alice.AuthID(), tc.args})
+			require.Nil(t, result.Error)
+			require.JSONEq(t, "1", string(result.Result))
+			repeated := callJSONRPC(t, given.ServerURL(), testusers.Alice, tc.method, []any{testusers.Alice.AuthID(), tc.args})
+			require.NotNil(t, repeated.Error)
+			require.NotEqual(t, "1", string(repeated.Result))
+		})
+	}
+	outputs, err := provider.ListOutputs(t.Context(), testusers.Alice.AuthID(), wdk.ListOutputsArgs{Basket: wdk.BasketNameForChange, Limit: 10})
