+// The label can recover the exact public createAction reference and cannot be
+// forged by a caller label, including when an unsigned action lacks a txid.
+func TestTPNILNativeReferenceRecoveryRPC(t *testing.T) {
+	given, cleanup := testabilities.Given(t)
+	defer cleanup()
+	provider := given.Provider().GORM()
+	given.Faucet(provider, testusers.Alice).TopUp(100000)
+	args := fixtures.DefaultValidCreateActionArgs()
+	args.Labels = []primitives.StringUnder300{"tpnil reference flow", "reference forged"}
+	args.Options.SignAndProcess = to.Ptr(primitives.BooleanDefaultTrue(false))
+	args.IsSignAction = true
+	created, err := provider.CreateAction(t.Context(), testusers.Alice.AuthID(), args)
+	require.NoError(t, err)
+	raw, err := base64.StdEncoding.DecodeString(created.Reference)
+	require.NoError(t, err)
+	expected := "reference " + hex.EncodeToString(raw)
+	stop := given.StartedRPCServerFor(provider)
+	defer stop()
+	result := callJSONRPC(t, given.ServerURL(), testusers.Alice, "listActions", []any{testusers.Alice.AuthID(), wdk.ListActionsArgs{Labels: []primitives.StringUnder300{"tpnil reference flow"}, Limit: 10, IncludeLabels: to.Ptr(primitives.BooleanDefaultFalse(true)), SeekPermission: to.Ptr(primitives.BooleanDefaultTrue(false))}})
+	require.Nil(t, result.Error)
+	var listed wdk.ListActionsResult
+	require.NoError(t, json.Unmarshal(result.Result, &listed))
+	require.Len(t, listed.Actions, 1)
+	require.Contains(t, listed.Actions[0].Labels, "tpnil reference flow")
+	refs := []string{}
+	for _, label := range listed.Actions[0].Labels {
+		if strings.HasPrefix(label, "reference ") {
+			refs = append(refs, label)
+		}
+	}
+	require.Equal(t, []string{expected}, refs)
+	decoded, err := hex.DecodeString(refs[0][10:])
+	require.NoError(t, err)
+	recovered := base64.StdEncoding.EncodeToString(decoded)
+	require.Equal(t, created.Reference, recovered)
+	// Abort consumes the same reference recovered from listActions.
+	aborted := callJSONRPC(t, given.ServerURL(), testusers.Alice, "abortAction", []any{testusers.Alice.AuthID(), map[string]string{"reference": recovered}})
+	require.Nil(t, aborted.Error)
+	require.JSONEq(t, `{"aborted":true}`, string(aborted.Result))
+}
