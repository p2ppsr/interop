+	require.Zero(t, outputs.TotalOutputs)
+	certs, err := provider.ListCertificates(t.Context(), testusers.Alice.AuthID(), wdk.ListCertificatesArgs{})
+	require.NoError(t, err)
+	require.Zero(t, certs.TotalCertificates)
