+package rpcserver
+
+import (
+	"context"
+	"github.com/bsv-blockchain/go-wallet-toolbox/pkg/wdk"
+	"log/slog"
+)
+
+// TypeScriptRPCStorageProvider preserves the TS storage mutation row-count
+// contract while retaining the Go provider's error-only local and REST API.
+// Embedded methods keep the same authenticated identity and user binding.
+type TypeScriptRPCStorageProvider struct{ *RPCStorageProvider }
+
+func NewTypeScriptRPCStorageProvider(logger *slog.Logger, provider wdk.WalletStorageProvider) *TypeScriptRPCStorageProvider {
+	return &TypeScriptRPCStorageProvider{NewRPCStorageProvider(logger, provider)}
+}
+
+func (p *TypeScriptRPCStorageProvider) RelinquishOutput(ctx context.Context, auth wdk.AuthID, args wdk.RelinquishOutputArgs) (int, error) {
+	if err := p.RPCStorageProvider.RelinquishOutput(ctx, auth, args); err != nil {
+		return 0, err
+	}
+	return 1, nil
+}
+
+func (p *TypeScriptRPCStorageProvider) RelinquishCertificate(ctx context.Context, auth wdk.AuthID, args wdk.RelinquishCertificateArgs) (int, error) {
+	if err := p.RPCStorageProvider.RelinquishCertificate(ctx, auth, args); err != nil {
+		return 0, err
+	}
+	return 1, nil
+}
