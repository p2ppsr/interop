+	"strings"
+	"testing"
+	"time"
+)
+
+func TestTPNILReferenceLabelsAreWalletAuthoredAndStatusStable(t *testing.T) {
+	raw := []byte{0, 1, 2, 0xfa, 0xff}
+	reference := base64.StdEncoding.EncodeToString(raw)
+	for _, status := range []wdk.TxStatus{wdk.TxStatusUnsigned, wdk.TxStatusNoSend, wdk.TxStatusSending, wdk.TxStatusUnproven, wdk.TxStatusCompleted, wdk.TxStatusFailed} {
+		t.Run(string(status), func(t *testing.T) {
+			tx := &pkgentity.Transaction{ID: 1, Reference: reference, Status: status, CreatedAt: time.UnixMilli(1704067200000)}
+			labels := []string{"app label", "reference forged", "reference stale", "another label"}
+			before := append([]string{}, labels...)
+			row := wdk.WalletAction{Satoshis: -19}
+			list := &listActions{}
+			require.NoError(t, list.mapLabelsToAction(&row, tx, map[uint][]string{1: labels}, true))
+			require.Equal(t, []string{"app label", "another label", "reference " + hex.EncodeToString(raw), "action time 1704067200000"}, row.Labels)
+			require.EqualValues(t, -19, row.Satoshis)
+			require.Equal(t, before, labels, "synthetic response must not persist into label storage")
+			decoded, err := hex.DecodeString(row.Labels[2][10:])
+			require.NoError(t, err)
+			require.Equal(t, reference, base64.StdEncoding.EncodeToString(decoded))
+			rows := []wdk.WalletAction{{Satoshis: -19}}
+			require.NoError(t, list.mapInputsOutputsLabels(rows, []*pkgentity.Transaction{tx}, mapActionDetails{labelMap: map[uint][]string{1: labels}}, &wdk.ListActionsArgs{IncludeLabels: to.Ptr(primitives.BooleanDefaultFalse(false))}, false))
+			require.Nil(t, rows[0].Labels)
+		})
+	}
+}
+func TestTPNILReferenceLabelsRejectMalformedStoredIdentity(t *testing.T) {
+	list := &listActions{}
+	row := wdk.WalletAction{}
+	require.ErrorContains(t, list.mapLabelsToAction(&row, &pkgentity.Transaction{ID: 1, Reference: "%%%"}, map[uint][]string{1: {"reference forged"}}, false), "invalid stored action reference")
+	for _, reference := range []string{"Af==", "AQ\nI=", base64.StdEncoding.EncodeToString([]byte(strings.Repeat("x", 146)))} {
+		require.Error(t, list.mapLabelsToAction(&row, &pkgentity.Transaction{ID: 1, Reference: reference}, nil, false))
+	}
+	require.NoError(t, list.mapLabelsToAction(&row, &pkgentity.Transaction{ID: 1, Reference: "AQI"}, map[uint][]string{1: {"normal"}}, false))
+	require.Equal(t, []string{"normal", "reference 0102"}, row.Labels)
+}
