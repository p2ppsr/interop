+// Regression: encrypted field values are not the subject's encrypted keyring.
+func TestCertificateKeyringUsesStoredMasterKey(t *testing.T) {
+	given, cleanup := testabilities.Given(t)
+	defer cleanup()
+	provider := given.Provider().GORM()
+	certificate := fixtures.DefaultInsertCertAuth(testusers.Alice.ID, primitives.PubKeyHex(testusers.Alice.PubKey(t)))
+	certificate.Fields[0].MasterKey = primitives.Base64String("bWFzdGVyIGtleQ==")
+	_, err := provider.InsertCertificateAuth(t.Context(), testusers.Alice.AuthID(), certificate)
+	require.NoError(t, err)
+	result, err := provider.ListCertificates(t.Context(), testusers.Alice.AuthID(), wdk.ListCertificatesArgs{})
+	require.NoError(t, err)
+	require.Len(t, result.Certificates, 1)
+	assert.Equal(t, primitives.Base64String("bWFzdGVyIGtleQ=="), result.Certificates[0].Keyring[exampleFieldName])
+	assert.Equal(t, exampleFieldValue, result.Certificates[0].Fields[exampleFieldName])
+}
