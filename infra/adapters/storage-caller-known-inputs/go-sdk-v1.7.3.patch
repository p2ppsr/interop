+package transaction_test
+
+import (
+	"context"
+	"fmt"
+	"github.com/bsv-blockchain/go-sdk/chainhash"
+	"github.com/bsv-blockchain/go-sdk/transaction"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+type exactSuppliedProofTracker struct {
+	calls  int
+	root   chainhash.Hash
+	height uint32
+	accept bool
+}
+
+func (t *exactSuppliedProofTracker) CurrentHeight(context.Context) (uint32, error) { return 1000, nil }
+func (t *exactSuppliedProofTracker) IsValidRootForHeight(_ context.Context, root *chainhash.Hash, height uint32) (bool, error) {
+	t.calls++
+	return t.accept && *root == t.root && height == t.height, nil
+}
+func TestSuppliedBUMPIsVerifiedRegardlessOfMarker(t *testing.T) {
+	for _, known := range []bool{false, true} {
+		for _, marker := range []string{"marked", "unmarked", "nil"} {
+			for _, valid := range []bool{false, true} {
+				t.Run(fmt.Sprintf("known=%v/marker=%s/valid=%v", known, marker, valid), func(t *testing.T) {
+					b, id := capturedKnownBeef(t)
+					flag := marker == "marked"
+					var flagPtr *bool
+					if marker != "nil" {
+						flagPtr = &flag
+					}
+					bump := &transaction.MerklePath{BlockHeight: 1, Path: [][]*transaction.PathElement{{{Offset: 0, Hash: &id, Txid: flagPtr}}}}
+					b.BUMPs = []*transaction.MerklePath{bump}
+					b.Transactions[id].DataFormat = transaction.RawTxAndBumpIndex
+					b.Transactions[id].BumpIndex = 0
+					b.Transactions[id].Transaction.MerklePath = bump
+					wire, err := b.Bytes()
+					require.NoError(t, err)
+					parsed, err := transaction.NewBeefFromBytes(wire)
+					require.NoError(t, err)
+					tracker := &exactSuppliedProofTracker{root: id, height: 1, accept: valid}
+					var ids []chainhash.Hash
+					if known {
+						ids = []chainhash.Hash{id}
+					}
+					ok, err := parsed.VerifyWithKnownTxIDs(t.Context(), tracker, true, ids)
+					require.NoError(t, err)
+					require.Equal(t, valid, ok)
+					require.Equal(t, 1, tracker.calls, "Supplied proof must reach the independent chain tracker")
+				})
+			}
+		}
+	}
+}
+func TestCallerKnownRootCannotDiscardSuppliedProofMetadata(t *testing.T) {
+	for _, kind := range []string{"index-negative", "index-out-of-range", "wrong-membership", "extraneous-unmarked-false", "extraneous-unmarked-valid", "contradictory-height", "empty-path", "nil-upper-element"} {
+		t.Run(kind, func(t *testing.T) {
+			b, id := capturedKnownBeef(t)
+			unmarked := false
+			other := chainhash.Hash{7}
+			bump := &transaction.MerklePath{BlockHeight: 1, Path: [][]*transaction.PathElement{{{Offset: 0, Hash: &id, Txid: &unmarked}}}}
+			b.BUMPs = []*transaction.MerklePath{bump}
+			b.Transactions[id].DataFormat = transaction.RawTxAndBumpIndex
+			b.Transactions[id].BumpIndex = 0
+			b.Transactions[id].Transaction.MerklePath = bump
+			tracker := &exactSuppliedProofTracker{root: id, height: 1, accept: true}
+			switch kind {
+			case "index-negative":
+				b.Transactions[id].BumpIndex = -1
+			case "index-out-of-range":
+				b.Transactions[id].BumpIndex = 1
+			case "wrong-membership":
+				bump.Path[0][0].Hash = &other
+				tracker.root = other
+			case "extraneous-unmarked-false", "extraneous-unmarked-valid":
+				b.Transactions[id].DataFormat = transaction.RawTx
+				b.Transactions[id].Transaction.MerklePath = nil
+				bump.Path[0][0].Hash = &other
+				tracker.root = other
+				tracker.accept = kind == "extraneous-unmarked-valid"
+			case "contradictory-height":
+				b.BUMPs = append(b.BUMPs, &transaction.MerklePath{BlockHeight: 1, Path: [][]*transaction.PathElement{{{Offset: 0, Hash: &other, Txid: &unmarked}}}})
+			case "empty-path":
+				bump.Path = nil
+			case "nil-upper-element":
+				bump.Path = append(bump.Path, []*transaction.PathElement{nil})
+			}
+			ok, _ := b.VerifyWithKnownTxIDs(t.Context(), tracker, true, []chainhash.Hash{id})
+			require.Equal(t, kind == "extraneous-unmarked-valid", ok)
+			if kind == "extraneous-unmarked-valid" || kind == "extraneous-unmarked-false" {
+				require.Equal(t, 1, tracker.calls)
+			}
+		})
+	}
+}
+func TestNilReceiverWithEmptyAndNonemptyKnownRoots(t *testing.T) {
+	var b *transaction.Beef
+	for _, ids := range [][]chainhash.Hash{nil, {{1}}} {
+		ok, err := b.VerifyWithKnownTxIDs(t.Context(), &knownRootTracker{}, true, ids)
+		require.False(t, ok)
+		require.Error(t, err)
+	}
+}
