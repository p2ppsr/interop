+// VerifyWithKnownTxIDs verifies all supplied proof and every undeclared branch,
+// allowing only the exact caller-declared roots to terminate input ancestry.
+// The trust decision is per invocation. Raw roots remain in the BEEF and are
+// hash-bound to their declared identity; this does not persist or promote trust.
+func (b *Beef) VerifyWithKnownTxIDs(ctx context.Context, tracker chaintracker.ChainTracker, allowTxidOnly bool, knownTxIDs []chainhash.Hash) (bool, error) {
+	if b == nil {
+		return false, fmt.Errorf("nil beef")
+	}
+	if len(knownTxIDs) == 0 {
+		return b.Verify(ctx, tracker, allowTxidOnly)
+	}
+	known := make(map[chainhash.Hash]bool, len(knownTxIDs))
+	for _, id := range knownTxIDs {
+		known[id] = true
+	}
+	// Validate every map/body association, even on trusted roots. Supplied BUMPs
+	// remain subject to all original consistency and independent chain checks.
+	for id, bt := range b.Transactions {
+		if bt == nil {
+			return false, fmt.Errorf("nil beef transaction")
+		}
+		switch bt.DataFormat {
+		case TxIDOnly:
+			if bt.KnownTxID == nil || *bt.KnownTxID != id || bt.Transaction != nil {
+				return false, fmt.Errorf("invalid txid-only identity")
+			}
+		case RawTx, RawTxAndBumpIndex:
+			if bt.Transaction == nil || *bt.Transaction.TxID() != id {
+				return false, fmt.Errorf("raw transaction identity mismatch")
+			}
+			for _, input := range bt.Transaction.Inputs {
+				if input == nil || input.SourceTXID == nil {
+					return false, fmt.Errorf("missing source transaction identity")
+				}
+			}
+		default:
+			return false, fmt.Errorf("unknown beef data format")
+		}
+	}
+	for _, bump := range b.BUMPs {
+		if bump == nil || len(bump.Path) == 0 || len(bump.Path[0]) == 0 {
+			return false, fmt.Errorf("invalid supplied merkle path")
+		}
+		for _, level := range bump.Path {
+			for _, leaf := range level {
+				if leaf == nil {
+					return false, fmt.Errorf("nil merkle path element")
+				}
+			}
+		}
+	}
+	result := b.verifyValidWithKnownTxIDs(allowTxidOnly, known)
+	if !result.valid {
+		return false, nil
+	}
+	for height, root := range result.roots {
+		hash, err := chainhash.NewHashFromHex(root)
+		if err != nil {
+			return false, err
+		}
+		ok, err := tracker.IsValidRootForHeight(ctx, hash, height)
+		if err != nil || !ok {
+			return false, err
+		}
+	}
+	return true, nil
+}
