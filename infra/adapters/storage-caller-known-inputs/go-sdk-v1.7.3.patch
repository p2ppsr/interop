+package transaction_test
+
+import (
+	"context"
+	"encoding/hex"
+	"github.com/bsv-blockchain/go-sdk/chainhash"
+	"github.com/bsv-blockchain/go-sdk/script"
+	"github.com/bsv-blockchain/go-sdk/transaction"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+type knownRootTracker struct{ calls int }
+
+func (k *knownRootTracker) CurrentHeight(context.Context) (uint32, error) { return 1000, nil }
+func (k *knownRootTracker) IsValidRootForHeight(context.Context, *chainhash.Hash, uint32) (bool, error) {
+	k.calls++
+	return false, nil
+}
+func capturedKnownBeef(t *testing.T) (*transaction.Beef, chainhash.Hash) {
+	raw, err := hex.DecodeString("0200beef000100010000000125db0888dcee5300bf81848cbc505d7b90a5a4ecc39577db23d50f1f85132efb000000000151ffffffff02f401000000000000027551ea010000000000001976a914da242beec042fb58a3678781e061ba06db5a13c488ac00000000")
+	require.NoError(t, err)
+	b, err := transaction.NewBeefFromBytes(raw)
+	require.NoError(t, err)
+	for id := range b.Transactions {
+		return b, id
+	}
+	t.Fatal("empty")
+	return nil, chainhash.Hash{}
+}
+func childOf(t *testing.T, parent *transaction.Transaction, unlock string) *transaction.Transaction {
+	s, err := script.NewFromHex(unlock)
+	require.NoError(t, err)
+	lock, err := script.NewFromHex("7551")
+	require.NoError(t, err)
+	tx := transaction.NewTransaction()
+	tx.AddInput(&transaction.TransactionInput{SourceTXID: parent.TxID(), SourceTxOutIndex: 0, UnlockingScript: s, SequenceNumber: 0xffffffff})
+	tx.AddOutput(&transaction.TransactionOutput{Satoshis: 400, LockingScript: lock})
+	return tx
+}
+func TestCallerKnownRootsAreExactAndRequestScoped(t *testing.T) {
+	for _, kind := range []string{"accept-raw-root", "no-root-declaration", "wrong-root", "raw-mutated-old-claim", "map-key-mismatch", "nil-record", "unknown-format", "mixed-undeclared-branch", "known-root-valid-child", "known-root-child-mutated-parent", "nil-bump", "empty-bump", "false-supplied-proof", "request-isolation", "txid-only-identity-mismatch"} {
+		t.Run(kind, func(t *testing.T) {
+			b, id := capturedKnownBeef(t)
+			tracker := &knownRootTracker{}
+			known := []chainhash.Hash{id}
+			want := kind == "accept-raw-root" || kind == "known-root-valid-child" || kind == "request-isolation"
+			switch kind {
+			case "no-root-declaration":
+				known = nil
+			case "wrong-root":
+				known = []chainhash.Hash{{1}}
+			case "raw-mutated-old-claim":
+				tx := b.Transactions[id].Transaction
+				tx.Outputs[0].Satoshis++
+				delete(b.Transactions, id)
+				b.Transactions[*tx.TxID()] = &transaction.BeefTx{DataFormat: transaction.RawTx, Transaction: tx}
+			case "map-key-mismatch":
+				b.Transactions[id].Transaction.Outputs[0].Satoshis++
+			case "nil-record":
+				b.Transactions[id] = nil
+			case "unknown-format":
+				b.Transactions[id].DataFormat = 99
+			case "mixed-undeclared-branch":
+				tx := childOf(t, b.Transactions[id].Transaction, "51")
+				tx.Inputs[0].SourceTXID = &chainhash.Hash{3}
+				_, err := b.MergeRawTx(tx.Bytes(), nil)
+				require.NoError(t, err)
+			case "known-root-valid-child":
+				tx := childOf(t, b.Transactions[id].Transaction, "51")
+				_, err := b.MergeRawTx(tx.Bytes(), nil)
+				require.NoError(t, err)
+			case "known-root-child-mutated-parent":
+				tx := childOf(t, b.Transactions[id].Transaction, "51")
+				tx.Inputs[0].SourceTXID = &chainhash.Hash{3}
+				_, err := b.MergeRawTx(tx.Bytes(), nil)
+				require.NoError(t, err)
+			case "nil-bump":
+				b.BUMPs = []*transaction.MerklePath{nil}
+			case "empty-bump":
+				b.BUMPs = []*transaction.MerklePath{{BlockHeight: 1}}
+			case "false-supplied-proof":
+				yes := true
+				b.BUMPs = []*transaction.MerklePath{{BlockHeight: 1, Path: [][]*transaction.PathElement{{{Offset: 0, Hash: &id, Txid: &yes}}}}}
+			case "txid-only-identity-mismatch":
+				b.Transactions[id] = &transaction.BeefTx{DataFormat: transaction.TxIDOnly, KnownTxID: &chainhash.Hash{2}}
+			}
+			ok, err := b.VerifyWithKnownTxIDs(t.Context(), tracker, true, known)
+			if want {
+				require.NoError(t, err)
+				require.True(t, ok)
+			} else {
+				require.False(t, ok)
+			}
+			if kind == "false-supplied-proof" {
+				require.Equal(t, 1, tracker.calls)
+			}
+			if kind == "request-isolation" {
+				again, err := b.Verify(t.Context(), tracker, true)
+				require.NoError(t, err)
+				require.False(t, again)
+				again, err = b.VerifyWithKnownTxIDs(t.Context(), tracker, true, nil)
+				require.NoError(t, err)
+				require.False(t, again)
+			}
+		})
+	}
+}
