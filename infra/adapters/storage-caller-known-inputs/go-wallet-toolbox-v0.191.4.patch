+package storage_test
+
+import (
+	"github.com/bsv-blockchain/go-sdk/transaction"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+// confirmSyntheticFixtureBumps supplies exact chain-tracker responses only for
+// source-authored positive fixtures. It is never a verifier override: subsequent
+// mutated proofs still have to match a registered height/root on the real path.
+func confirmSyntheticFixtureBumps(t *testing.T, bhs interface{ OnMerkleRootVerifyResponse(uint32, string, string) }, raw []byte) {
+	t.Helper()
+	beef, err := transaction.NewBeefFromBytes(raw)
+	require.NoError(t, err)
+	require.NotEmpty(t, beef.BUMPs)
+	for _, bump := range beef.BUMPs {
+		require.NotNil(t, bump)
+		require.NotEmpty(t, bump.Path)
+		var expected string
+		for _, leaf := range bump.Path[0] {
+			require.NotNil(t, leaf)
+			if leaf.Hash == nil {
+				continue
+			}
+			root, err := bump.ComputeRoot(leaf.Hash)
+			require.NoError(t, err)
+			require.NotNil(t, root)
+			if expected == "" {
+				expected = root.String()
+			} else {
+				require.Equal(t, expected, root.String())
+			}
+		}
+		require.NotEmpty(t, expected)
+		bhs.OnMerkleRootVerifyResponse(bump.BlockHeight, expected, "CONFIRMED")
+	}
+}
