+					if variant == "invalid-descendant" {
+						unlock = ""
+					}
+					sc, err := script.NewFromHex(unlock)
+					require.NoError(t, err)
+					lock, err := script.NewFromHex("7551")
+					require.NoError(t, err)
+					child := transaction.NewTransaction()
+					child.AddInput(&transaction.TransactionInput{SourceTXID: src.TxID(), SourceTxOutIndex: 0, UnlockingScript: sc, SequenceNumber: 0xffffffff})
+					child.AddOutput(&transaction.TransactionOutput{Satoshis: 400, LockingScript: lock})
+					if variant == "mixed-unknown-branch" {
+						child.Inputs[0].SourceTxOutIndex = 99
+					} else {
+						args.Inputs[0].Outpoint.TxID = child.TxID().String()
+						args.Outputs[0].Satoshis = 300
+					}
+					_, err = beef.MergeRawTx(child.Bytes(), nil)
+					require.NoError(t, err)
+				}
+				args.InputBEEF, err = beef.Bytes()
+				require.NoError(t, err)
+			}
+			var before int64
+			require.NoError(t, provider.Database.DB.Table(provider.Database.DB.NamingStrategy.TableName("KnownTx")).Where("tx_id IN ?", []string{"48adf3470203b990cb0b4acb17473948dde6be632da1a3fa2babf93e09a01d77", "fb2e13851f0fd523db7795c3eca4a5907b5d50bc8c8481bf0053eedc8808db25"}).Count(&before).Error)
+			require.Zero(t, before, "Neither source nor supporting parent existed in provider")
+			result, err := provider.CreateAction(t.Context(), auth, args)
+			if variant == "explicit-known" || variant == "complete-proof" || variant == "valid-descendant" || variant == "repeat-without-claim" || variant == "invalid-current-spend" || variant == "legacy-complete-proof" {
+				require.NoError(t, err, "BRC100 39a643ff lines656-657 permits exact caller-declared valid input without previous wallet knowledge")
+				require.NotNil(t, result)
+				require.Equal(t, args.Inputs[0].Outpoint.TxID, string(result.Inputs[0].SourceTxID))
+				if variant == "invalid-current-spend" {
+					input, err := transaction.NewBeefFromBytes(args.InputBEEF)
+					require.NoError(t, err)
+					source := input.FindTransaction(sourceID)
+					require.NotNil(t, source)
+					unlock, err := script.NewFromHex("6a")
+					require.NoError(t, err)
+					current := transaction.NewTransaction()
+					current.AddInput(&transaction.TransactionInput{SourceTXID: source.TxID(), SourceTxOutIndex: 0, UnlockingScript: unlock, SequenceNumber: 0xffffffff})
+					for _, out := range result.Outputs {
+						lockHex := string(out.LockingScript)
+						if lockHex == "" {
+							lockHex = "7551"
+						}
+						lock, err := script.NewFromHex(lockHex)
+						require.NoError(t, err)
+						current.AddOutput(&transaction.TransactionOutput{Satoshis: uint64(out.Satoshis), LockingScript: lock})
+					}
+					processed, err := provider.ProcessAction(t.Context(), auth, wdk.ProcessActionArgs{IsNewTx: true, IsNoSend: false, IsDelayed: false, Reference: to.Ptr(result.Reference), TxID: to.Ptr(primitives.TXIDHexString(current.TxID().String())), RawTx: current.Bytes()})
+					require.Error(t, err)
+					require.Nil(t, processed)
+					require.Contains(t, err.Error(), "script verification failed", "New spend's script must be executed even though its input was caller-declared valid")
+				}
+				if variant == "repeat-without-claim" {
+					args.Options.KnownTxids = nil
+					next, err := provider.CreateAction(t.Context(), auth, args)
+					require.Error(t, err)
+					require.Nil(t, next)
+					var count int64
+					require.NoError(t, provider.Database.DB.Table(provider.Database.DB.NamingStrategy.TableName("KnownTx")).Where("tx_id IN ?", []string{sourceID, "fb2e13851f0fd523db7795c3eca4a5907b5d50bc8c8481bf0053eedc8808db25"}).Count(&count).Error)
+					require.Zero(t, count, "No persistent knowledge promotion")
+				}
+			} else {
+				require.Error(t, err)
+				require.Nil(t, result)
+			}
+		})
+	}
