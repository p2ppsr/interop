{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TPNIL qualification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "claim", "logicalOrigin", "artifact", "assertions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
    "claim": { "const": "INFRASTRUCTURE_QUALIFICATION_ONLY" },
    "logicalOrigin": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "size"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
          "kind": { "enum": ["response", "json-equals", "reference-closure", "repeat-equal"] },
          "path": { "type": "string", "pattern": "^/" },
          "status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "contentType": { "type": "string", "minLength": 1 },
          "bodySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pointer": { "type": "string", "pattern": "^/" },
          "expected": {}
        }
      }
    }
  }
}
